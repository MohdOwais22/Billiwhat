# Application Branding Configuration
NEXT_PUBLIC_APP_NAME=WhatsBill

# GEMINI_API_KEY: Required for Gemini AI features (Server side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL for this WhatsBill instance
APP_URL="MY_APP_URL"

# Supabase Configuration for WhatsBill
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Sentry Configuration
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="whatsbill@1.0.0"
